# ==========================================
# CẤU HÌNH BOT TELEGRAM VÍ ĐÔI (BẢO & OANH)
# ==========================================

# 1. Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Mã gia đình và PIN (trùng với mã trên app Ví Đôi PWA)
FAMILY_CODE=BO8686
FAMILY_PIN=2611

# 3. Google Gemini API Key để quét hóa đơn bằng AI (Lấy miễn phí tại aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 4. Thư mục lưu dữ liệu cục bộ trên server
DATA_DIR=./data
